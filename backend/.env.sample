TZ=Asia/Seoul
DB_PORT=5432

# PostgreSQL DB connection settings
DB_PORT=5432
DB_HOST=localhost
DB_USER=1team
DB_NAME=1team
DB_PASSWORD=1team

# Backend server
HOST=0.0.0.0
PORT=8000

# Frontend callback target after OAuth login
FRONTEND_BASE_URL=http://localhost:3000

# Signed auth cookie secret. Replace with a long random value in real use.
AUTH_COOKIE_SECRET=1team_secret_key_for_cookies

DATABASE_URL=postgresql://1team:1team@localhost:5432/1team
```env
# Kakao OAuth keys
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# Naver OAuth keys
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_REDIRECT_URI=http://localhost:8000/auth/naver/callback

# Google OAuth keys
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Toss Payments (Test Key)
TOSS_CLIENT_KEY=your_toss_client_key
TOSS_SECRET_KEY=your_toss_secret_key

TOSS_SUCCESS_URL=http://localhost:3000/payment/success
TOSS_FAIL_URL=http://localhost:3000/payment/fail
```

# Redis 연결 주소
# 백엔드가 Docker Compose 같은 컨테이너 네트워크 안에서 실행될 때는 컨테이너 이름(final_redis)으로 접근합니다.
REDIS_URL=redis://localhost:6379/0

# 로그인 세션 유지 시간: 7일
REDIS_SESSION_TTL_SECONDS=604800

# OAuth state 유지 시간: 5분
REDIS_OAUTH_STATE_TTL_SECONDS=300

# 대시보드 통계 캐시 유지 시간: 10초
REDIS_DASHBOARD_CACHE_TTL_SECONDS=10

# 처리 진행률 캐시 유지 시간: 1시간
REDIS_PROGRESS_TTL_SECONDS=3600
