TZ=Asia/Seoul
DB_PORT=5432

# PostgreSQL container
POSTGRES_DB=1team
POSTGRES_USER=1team
POSTGRES_PASSWORD=1team

# Backend server
HOST=0.0.0.0
PORT=8000

# Frontend callback target after OAuth login
FRONTEND_BASE_URL=http://localhost:3000

# Signed auth cookie secret. Replace with a long random value in real use.
AUTH_COOKIE_SECRET=

# Kakao OAuth keys
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# Google OAuth keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Facebook OAuth keys
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback

# X OAuth keys
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/auth/x/callback

# Redis 연결 주소
# 백엔드가 Docker Compose 같은 컨테이너 네트워크 안에서 실행될 때는 컨테이너 이름(final_redis)으로 접근합니다.
REDIS_URL=redis://final_redis:6379/0

# 로그인 세션 유지 시간: 7일
REDIS_SESSION_TTL_SECONDS=604800

# OAuth state 유지 시간: 5분
REDIS_OAUTH_STATE_TTL_SECONDS=300

# 대시보드 통계 캐시 유지 시간: 10초
REDIS_DASHBOARD_CACHE_TTL_SECONDS=10

# 처리 진행률 캐시 유지 시간: 1시간
REDIS_PROGRESS_TTL_SECONDS=3600
