TZ=Asia/Seoul
DB_PORT=5432

# PostgreSQL DB connection settings
DB_PORT=5432
DB_HOST=localhost
DB_USER=1team
DB_NAME=1team
DB_PASSWORD=1team

# Backend server
HOST=0.0.0.0
PORT=8000

# Frontend callback target after OAuth login
FRONTEND_BASE_URL=http://localhost:3000

# Signed auth cookie secret. Replace with a long random value in real use.
AUTH_COOKIE_SECRET=1team_secret_key_for_cookies

# Kakao OAuth keys
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/auth/kakao/callback

# Naver OAuth keys
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/auth/naver/callback

# Google OAuth keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# File upload settings
UPLOAD_DIR=storage/uploads      # 기본값으로 동작하나 명시 권장
TEMP_DIR=storage/temp           # 기본값으로 동작하나 명시 권장
CHUNK_UPLOAD_EXPIRE_HOURS=24    # 미완료 업로드 만료 시간

# Redis 연결 주소
# 백엔드가 Docker Compose 같은 컨테이너 네트워크 안에서 실행될 때는 컨테이너 이름(final_redis)으로 접근합니다.
REDIS_URL=redis://localhost:6379/0

# 로그인 세션 유지 시간: 7일
REDIS_SESSION_TTL_SECONDS=604800

# OAuth state 유지 시간: 5분
REDIS_OAUTH_STATE_TTL_SECONDS=300

# 대시보드 통계 캐시 유지 시간: 10초
REDIS_DASHBOARD_CACHE_TTL_SECONDS=10

# 처리 진행률 캐시 유지 시간: 1시간
REDIS_PROGRESS_TTL_SECONDS=3600

# Colab Worker 인증 시크릿 (Worker가 API 호출 시 Authorization: Bearer <값> 헤더로 전달)
WORKER_SECRET=change_me_to_a_long_random_secret

# ngrok 터널 (로컬 개발 시 Colab과 연결할 때만 사용)
# USE_NGROK=true 로 설정하면 백엔드 시작 시 자동으로 터널을 열고 URL을 출력합니다.
USE_NGROK=false
NGROK_AUTHTOKEN=
